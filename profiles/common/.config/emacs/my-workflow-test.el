(ert-deftest my/workflow-draft-selection-filtering-and-finalize ()
  (my/workflow-test-with-storage
    (my/workflow-test-with-tabs
      (cl-letf (((symbol-function 'my/workflow-open-task) (lambda (task) task))
                ((symbol-function 'y-or-n-p) (lambda (&rest _arguments) t)))
        (let* ((first (my/work-start "First task" workspace "alpha" "first"))
               (second (my/work-start "Second task" workspace-two "alpha" "second"))
               (index (my/workflow-project-index-file "alpha"))
               (schema (my/workflow-project-schema (find-file-noselect index))))
          (my/workspace-select-or-create-tab workspace)
          (my/work-log 'progress "First task journal entry")
          (my/work-project-log "First task project log entry")
          (my/workspace-select-or-create-tab workspace-two)
          (my/work-log 'progress "Second task journal entry")
          (my/work-project-log "Second task project log entry")
          (with-current-buffer (find-file-noselect index)
            (save-excursion
              (goto-char (plist-get schema :docs))
              (org-end-of-subtree t)
              (insert "\n- [[file:relative-detail.md][Relative detail]]\n"
                      "- [[/ssh:build:/srv/private/detail.md][Remote detail]]\n")
              (save-buffer)))
          (let* ((schema (my/workflow-project-schema (find-file-noselect index)))
                 (items (my/workflow-draft-source-items second schema))
                 (sources
                  (seq-filter
                   (lambda (item)
                     (string-match-p
                      "\\`Docs 1:\\|\\`Project Log\\|Second task journal entry"
                      (plist-get item :label)))
                   items)))
            (should-not
             (seq-find
              (lambda (item)
                (string-match-p "First task" (plist-get item :label)))
              items))
            (my/work-draft-update sources))
          (let ((text (with-current-buffer "*Work Update Draft*" (buffer-string))))
            (should (string-match-p "Relative detail" text))
            (should-not (string-match-p "Remote detail" text))
            (should-not (string-match-p "relative-detail.md\|/ssh:build:" text))
            (should (string-match-p "Second task journal entry" text))
            (should-not (string-match-p "First task journal entry" text))
            (should (string-match-p "Second task project log entry" text))
            (should-not (string-match-p "First task project log entry" text))
            (should (< (string-match "Changed" text)
                       (string-match "Current status or blocker" text)
                       (string-match "Evidence" text)
                       (string-match "Next step" text))))
          (let (prompt candidates)
            (cl-letf (((symbol-function 'completing-read-multiple)
                       (lambda (selection-prompt collection &rest _arguments)
                         (setq prompt selection-prompt
                               candidates collection)
                         (list (seq-find
                                (lambda (candidate)
                                  (string-prefix-p "Docs 1:" candidate))
                                collection)))))
              (call-interactively #'my/work-draft-update))
            (should (equal prompt "Include sources: "))
            (should (member "Task text" candidates))
            (should (seq-find (lambda (candidate)
                                (string-prefix-p "Project Log 1:" candidate))
                              candidates))
            (should-not (seq-find (lambda (candidate)
                                    (string-match-p "First task" candidate))
                                  candidates))
            (with-current-buffer "*Work Update Draft*"
              (should (string-match-p "Relative detail" (buffer-string)))
              (should-not (string-match-p "Remote detail\|Second task journal entry"
                                          (buffer-string)))
              (goto-char (point-max))
              (insert "\n/tmp/added-after-review")
              (let (copied confirmation)
                (cl-letf (((symbol-function 'y-or-n-p)
                           (lambda (confirmation-prompt)
                             (setq confirmation confirmation-prompt)
                             nil))
                          ((symbol-function 'kill-new)
                           (lambda (text &rest _arguments) (setq copied text))))
                  (should-error (my/work-draft-finalize) :type 'user-error))
                (should-not copied)
                (should (string-match-p "current draft" confirmation))))
          (should (equal (my/workflow-sanitize-draft-text
                          (concat "Prefix [[file:relative.org][Relative]] "
                                  "[[/ssh:build:/srv/a][Remote]] "
                                  "[[https://example.com][Public]]\n"
                                  "[[file:another.org][Another]]"))
                         "Prefix Relative Remote [[https://example.com][Public]]\nAnother"))
          (should (equal (plist-get second :id)
                         (my/tab-current-property 'my/work-task-id)))
          (should-not (equal (plist-get first :id) (plist-get second :id)))))))))

