(ert-deftest my/workflow-start-preflight-and-tab-rollback ()
  (my/workflow-test-with-storage
    (my/workflow-test-with-tabs
      (cl-letf (((symbol-function 'my/workflow-open-task) (lambda (task) task)))
        (let ((index (my/workflow-project-index-file "new-project"))
              (before-tabs (copy-tree tabs))
              (before-agenda (copy-sequence org-agenda-files))
              (invalid-note (expand-file-name "invalid.txt" temporary-root)))
          (with-temp-file invalid-note (insert "not a detail note\n"))
          (dolist (arguments
                   (list (list "Bad\ntitle" workspace "new-project" "new-task")
                         (list "Good title" workspace "new\nproject" "new-task")
                         (list "Good title" workspace "new-project" "new\rkey")
                         (list "Good title" workspace "new-project" "new-task"
                               invalid-note)))
            (should-error (apply #'my/work-start arguments) :type 'user-error)
            (should-not (file-exists-p index))
            (should (equal org-agenda-files before-agenda))
            (should (equal tabs before-tabs)))
          (my/workspace-select-or-create-tab workspace)
          (my/tab-set-current-property 'my/work-task-id "another-task")
          (setq before-tabs (copy-tree tabs)
                before-agenda (copy-sequence org-agenda-files))
          (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _arguments) nil)))
            (should-error (my/work-start "Rejected tab rebind" workspace
                                         "new-project" "new-task")
                          :type 'user-error))
          (should-not (file-exists-p index))
          (should (equal org-agenda-files before-agenda))
          (should (equal tabs before-tabs))
          (should (eq (alist-get 'my/send-text-last-target (cdr (car tabs))) 'kept)))
      (let* ((task (my/work-start "Existing task" workspace-two "alpha" "existing"))
             (index (my/workflow-project-index-file "alpha"))
             (before-project (my/workflow-test-file-text index))
             (before-journal (my/workflow-test-file-text my/workflow-journal-file))
             (before-tabs (copy-tree tabs))
             (before-agenda (copy-sequence org-agenda-files))
             (answers '(t nil)))
        (cl-letf (((symbol-function 'y-or-n-p)
                   (lambda (&rest _arguments) (pop answers))))
          (should-error (my/work-start "Existing task" workspace "alpha" "existing")
                        :type 'user-error))
        (should (equal (my/workflow-test-file-text index) before-project))
        (should (equal (my/workflow-test-file-text my/workflow-journal-file)
                       before-journal))
        (should (equal org-agenda-files before-agenda))
        (should (equal tabs before-tabs))
        (should (equal (plist-get task :id)
                       (plist-get (my/workflow-find-task-by-key
                                   (my/workflow-project-schema (find-file-noselect index))
                                   "existing")
                                  :id))))
      (let ((before-tabs (copy-tree tabs))
            original-tab-set)
        (setq original-tab-set (symbol-function 'my/tab-set-current-property))
        (cl-letf (((symbol-function 'my/tab-set-current-property)
                   (lambda (property value)
                     (if (eq property 'my/work-task-id)
                         (error "task-id commit failed")
                       (funcall original-tab-set property value)))))
          (should-error (my/work-start "Rollback task" workspace-three
                                       "rollback" "rollback-task")))
        (should (equal tabs before-tabs))
        (should (eq (alist-get 'my/send-text-last-target (cdr (car tabs))) 'kept))
        (let* ((index (my/workflow-project-index-file "rollback"))
               (schema (my/workflow-project-schema (find-file-noselect index)))
               (task (my/workflow-find-task-by-key schema "rollback-task"))
               (journal (my/workflow-test-file-text my/workflow-journal-file)))
          (should task)
          (should (= (my/workflow-test-count
                      (regexp-quote (concat "[[id:" (plist-get task :id))) journal)
                     1))
          (my/work-start "Rollback task" workspace-three "rollback" "rollback-task")
          (should (= (my/workflow-test-count
                      (regexp-quote (concat "[[id:" (plist-get task :id)))
                      (my/workflow-test-file-text my/workflow-journal-file))
                     1))))))))

