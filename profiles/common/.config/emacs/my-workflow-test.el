;;; my-workflow-test.el --- Tests for project-partitioned Org work items -*- lexical-binding: t; -*-

;;; Code:

(require 'cl-lib)
(require 'ert)
(require 'org)

(add-to-list 'load-path
             (file-name-directory (or load-file-name buffer-file-name)))
(require 'my-workflow)

(defmacro my/workflow-test-with-storage (&rest body)
  "Run BODY with isolated Org and workflow storage."
  (declare (indent 0) (debug t))
  `(let* ((temporary-root (make-temp-file "my-workflow-test-" t))
          (workspace (expand-file-name "workspace/" temporary-root))
          (workspace-two (expand-file-name "workspace-two/" temporary-root))
          (workspace-three (expand-file-name "workspace-three/" temporary-root))
          (my/workflow-project-storage-root
           (expand-file-name "projects/" temporary-root))
          (my/workflow-journal-file (expand-file-name "journal.org" temporary-root))
          (my/workflow-life-file (expand-file-name "life.org" temporary-root))
          (org-directory temporary-root)
          (org-id-locations nil)
          (org-id-locations-file (expand-file-name ".org-id-locations" temporary-root))
          (org-agenda-files nil)
          (default-directory temporary-root))
     (make-directory workspace t)
     (make-directory workspace-two t)
     (make-directory workspace-three t)
     (unwind-protect
         (progn ,@body)
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer)
                    (string-prefix-p temporary-root (buffer-file-name buffer)))
           (set-buffer-modified-p nil)
           (kill-buffer buffer)))
       (delete-directory temporary-root t))))

(defmacro my/workflow-test-with-tabs (&rest body)
  "Run BODY with a public tab-bar API model and no real frame state."
  (declare (indent 0) (debug t))
  `(let ((tabs (list '(current-tab (name . "first")
                            (my/send-text-last-target . kept)))))
     (cl-letf
         (((symbol-function 'tab-bar-tabs)
           (lambda (&optional _frame) tabs))
          ((symbol-function 'tab-bar-tabs-set)
           (lambda (new-tabs &optional _frame) (setq tabs new-tabs)))
          ((symbol-function 'tab-bar-new-tab)
           (lambda (&optional _frame)
             (setq tabs
                   (append
                    (mapcar (lambda (tab)
                              (if (eq (car tab) 'current-tab)
                                  (cons 'tab (cdr tab))
                                tab))
                            tabs)
                    (list '(current-tab (name . "new")))))))
          ((symbol-function 'tab-bar-select-tab)
           (lambda (index &optional _frame)
             (setq tabs
                   (cl-loop for tab in tabs
                            for tab-index from 1
                            collect (cons (if (= index tab-index) 'current-tab 'tab)
                                          (cdr tab)))))))
       ,@body)))

(defun my/workflow-test-file-text (file)
  "Return FILE's complete contents for behavior assertions."
  (with-temp-buffer
    (insert-file-contents file)
    (buffer-string)))

(defun my/workflow-test-count (regexp text)
  "Return the count of REGEXP matches in TEXT."
  (let ((start 0)
        (count 0))
    (while (string-match regexp text start)
      (setq count (1+ count)
            start (match-end 0)))
    count))

(ert-deftest my/workflow-root-and-tab-contract ()
  (my/workflow-test-with-tabs
    (let ((first "/tmp/one/")
          (second "/tmp/two/"))
      (cl-letf (((symbol-function 'project-current)
                 (lambda (_maybe-prompt directory)
                   (when (string-prefix-p "/tmp/one" directory) 'project)))
                ((symbol-function 'project-root)
                 (lambda (_project) "/tmp/project")))
        (should (equal (my/workspace-normalize-root "/tmp/one/file/" )
                       "/tmp/project/"))
        (should (equal (my/workspace-normalize-root "/ssh:build:/srv/work")
                       "/ssh:build:/srv/work/")))
      (my/workspace-select-or-create-tab first)
      (my/tab-set-current-property 'my/work-task-id "task-one")
      (should (equal (my/workspace-tab-index first) 2))
      (should (equal (my/tab-find-index-by-property 'my/work-task-id "task-one") 2))
      (should (equal (my/tab-current-property 'my/send-text-last-target) nil))
      (my/workspace-select-or-create-tab second)
      (should (equal (my/workspace-tab-index second) 3))
      (my/tab-set-current-property 'my/work-task-id nil)
      (should-not (my/tab-current-property 'my/work-task-id)))))

(ert-deftest my/workflow-start-schema-journal-and-resume ()
  (my/workflow-test-with-storage
    (my/workflow-test-with-tabs
      (cl-letf (((symbol-function 'my/workflow-open-task) (lambda (task) task)))
        (let* ((first (my/work-start "Ship parser" workspace "compiler" "parser"))
               (second (my/work-start "Ship parser" workspace-two "runtime" "parser"))
               (first-index (my/workflow-project-index-file "compiler"))
               (second-index (my/workflow-project-index-file "runtime")))
          (should (file-exists-p first-index))
          (should (file-exists-p second-index))
          (should (plist-get first :id))
          (should-not (equal (plist-get first :id) (plist-get second :id)))
          (should (equal (plist-get first :key) "parser"))
          (should (equal (plist-get second :key) "parser"))
          (should (member first-index org-agenda-files))
          (should (member second-index org-agenda-files))
          (let ((first-text (my/workflow-test-file-text first-index))
                (journal (my/workflow-test-file-text my/workflow-journal-file)))
            (should (string-match-p (regexp-quote "** Docs\n\n** Tasks\n") first-text))
            (should (string-match-p ":ID:" first-text))
            (should (string-match-p ":WORK_KEY: parser" first-text))
            (should-not (string-match-p "LINEAR_\\|:linear:" first-text))
            (should (= (my/workflow-test-count "Work log" journal) 1))
            (should (string-match-p (regexp-quote (concat "[[id:" (plist-get first :id)))
                                    journal))
            (should (string-match-p (regexp-quote "[compiler/parser]") journal))
            (should (string-match-p (regexp-quote "[runtime/parser]") journal)))
          (my/work-start "Ship parser" workspace "compiler" "parser")
          (let ((schema (my/workflow-project-schema (find-file-noselect first-index))))
            (should (= (length (my/workflow-tasks schema)) 1)))
          (should (= (my/workflow-test-count "start:" (my/workflow-test-file-text
                                                     my/workflow-journal-file))
                     2)))))))

(ert-deftest my/workflow-start-interactive-selection-binds-unbound-tab ()
  (my/workflow-test-with-storage
    (my/workflow-test-with-tabs
      (cl-letf (((symbol-function 'my/workflow-open-task) (lambda (task) task)))
        (let ((task (my/work-start "Existing task" workspace "alpha" "existing")))
          (my/tab-set-current-property 'my/work-task-id nil)
          (cl-letf (((symbol-function 'my/workflow-read-project-key)
                     (lambda (_root) "alpha"))
                    ((symbol-function 'called-interactively-p)
                     (lambda (&rest _arguments) t))
                    ((symbol-function 'completing-read)
                     (lambda (_prompt collection &rest _arguments)
                       (cadr collection))))
            (let ((default-directory workspace))
              (call-interactively #'my/work-start)))
          (should (equal (my/tab-current-property 'my/work-task-id)
