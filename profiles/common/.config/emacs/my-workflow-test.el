                     1)))))))

(ert-deftest my/workflow-discovery-is-canonical-and-collision-safe ()
  (my/workflow-test-with-storage
    (let* ((schema (my/workflow-ensure-project "alpha" workspace))
           (index (my/workflow-project-index-file "alpha"))
           (notes (expand-file-name "notes/extra.org"
                                    (file-name-directory index)))
           (flat (expand-file-name "alpha.org" my/workflow-project-storage-root))
           (shared (expand-file-name "shared.org" my/workflow-project-storage-root))
           (broken (expand-file-name "broken/" my/workflow-project-storage-root))
           (duplicate (expand-file-name "duplicate/" my/workflow-project-storage-root)))
      (make-directory (file-name-directory notes) t)
      (with-temp-file notes (insert "* Auxiliary\n"))
      (with-temp-file flat (insert "* Flat\n"))
      (with-temp-file shared (insert "* Shared\n"))
      (make-directory broken t)
      (make-directory duplicate t)
      (with-temp-file (expand-file-name "index.org" broken)
        (insert "* broken\n:PROPERTIES:\n:ID: broken\n:PROJECT_KEY: broken\n"
                ":PROJECT_ROOT: /tmp/broken/\n:END:\n\n** Docs\n\n** Tasks\n"
                "*** Active\n\n** Log\n"))
      (with-temp-file (expand-file-name "index.org" duplicate)
        (insert "* duplicate\n:PROPERTIES:\n:ID: duplicate\n:PROJECT_KEY: duplicate\n"
                ":PROJECT_ROOT: /tmp/duplicate/\n:END:\n\n** Docs\n\n** Docs\n\n"
                "** Tasks\n*** Active\n\n*** Archive :ARCHIVE:\n\n** Log\n"))
      (with-temp-file my/workflow-life-file (insert "* Life\n"))
      (should (equal (my/workflow-discover-project-indexes) (list index)))
      (my/workflow-refresh-agenda)
      (should (equal org-agenda-files (list my/workflow-life-file index)))
      (should-not (member notes org-agenda-files))
      (should-not (member flat org-agenda-files))
      (should-not (member shared org-agenda-files))
      (should-not (member (expand-file-name "index.org" broken) org-agenda-files))
      (should-not (member (expand-file-name "index.org" duplicate) org-agenda-files))
      (with-current-buffer (find-file-noselect index)
        (save-excursion
          (goto-char (plist-get schema :docs))
          (org-end-of-subtree t)
          (insert "\n- [[file:reference.md][Reference]]\n")
          (goto-char (plist-get schema :tasks))
          (org-end-of-subtree t)
          (insert "\n*** Backlog\n")
          (goto-char (plist-get schema :project))
          (org-end-of-subtree t)
          (insert "\n** Notes\n")
          (save-buffer)))
      (setq schema (my/workflow-project-schema (find-file-noselect index)))
      (should schema)
      (with-current-buffer (find-file-noselect index)
        (save-excursion
          (goto-char (plist-get schema :active))
          (org-end-of-subtree t)
          (insert "\n**** Plain heading\n:PROPERTIES:\n:ID: not-a-task\n:END:\n")
          (save-buffer)))
      (should-not (my/workflow-tasks schema))
      (dolist (key '("" "." ".." "nested/key" "/absolute" "nested\\key"))
        (should-error (my/workflow-project-index-file key) :type 'user-error))
      (should-error (my/workflow-ensure-project "broken" workspace) :type 'user-error)
      (with-current-buffer (find-file-noselect index)
        (goto-char (point-min))
        (re-search-forward ":PROJECT_KEY: alpha")
        (replace-match ":PROJECT_KEY: wrong")
        (save-buffer))
      (let ((before (my/workflow-test-file-text index)))
        (should-error (my/workflow-ensure-project "alpha" workspace) :type 'user-error)
        (should (equal (my/workflow-test-file-text index) before)))
      (should (plist-get schema :id)))))

(ert-deftest my/workflow-lifecycle-project-log-note-archive-and-draft ()
  (my/workflow-test-with-storage
    (my/workflow-test-with-tabs
      (cl-letf (((symbol-function 'my/workflow-open-task) (lambda (task) task)))
        (let* ((task (my/work-start "Refine lexer" workspace "compiler" "lexer"))
               (index (my/workflow-project-index-file "compiler"))
               (note (expand-file-name "detail.md" temporary-root))
               (invalid-note (expand-file-name "detail.txt" temporary-root)))
          (with-temp-file note (insert "# Detail\n"))
          (with-temp-file invalid-note (insert "not a note\n"))
          (should-error (my/work-bind-note invalid-note) :type 'user-error)
          (should-not (plist-get task :note-file))
          (cl-letf (((symbol-function 'my/work-open) (lambda () nil)))
            (my/work-bind-note note))
          (my/work-log 'progress "Tests are green.")
          (my/work-project-log "Reviewed parser edge cases.")
          (my/work-set-state "DONE")
          (my/work-archive)
          (let ((schema (my/workflow-project-schema (find-file-noselect index))))
            (should-not (my/workflow-tasks schema))
            (should (equal (plist-get (car (my/workflow-tasks schema t)) :id)
                           (plist-get task :id))))
          (let ((journal (my/workflow-test-file-text my/workflow-journal-file))
                (project (my/workflow-test-file-text index)))
            (should (string-match-p "progress: Tests are green\." journal))
            (should (string-match-p (regexp-quote "[[file:") journal))
            (should (string-match-p "Reviewed parser edge cases\." project))
            (should-not (string-match-p "Reviewed parser edge cases\." journal)))
          (should (equal (my/workflow-sanitize-draft-text
                          ":PROPERTIES:\n:ID: hidden\n:END:\n[[file:/tmp/private.md][Detail]]")
                         "Detail"))
          (should (my/workflow-draft-sensitive-p "token=abc /tmp/private")))))))

