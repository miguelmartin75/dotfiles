  (my/appearance-load-theme)
  (require 'markdown-mode)
  (require 'markdown-ts-mode)
  (should (treesit-ready-p 'markdown t))
  (should (treesit-ready-p 'markdown-inline t))
  (let ((source
         "# Heading *emphasis*\n\n> quote\n\n- [x] item\n\n[link](https://example.com)\n\n| head | cell |\n| --- | --- |\n| one | two |\n\n```elisp\n(code)\n```\n\n`inline`\n"))
    (with-temp-buffer
      (insert source)
      (markdown-ts-mode)
      (font-lock-ensure)
      (my/appearance-assert-rendered-faces my/appearance-markdown-ts-attributes)
      (my/appearance-assert-tokens
       '(("#" markdown-ts-delimiter)
         ("Heading" markdown-ts-heading-1)
         ("emphasis" markdown-ts-emphasis)
         (">" markdown-ts-delimiter)
         ("quote" markdown-ts-block-quote)
         ("-" markdown-ts-list-marker)
         ("[x]" markdown-ts-task-checked)
         ("link" markdown-ts-link)
         ("https://example.com" markdown-ts-link-destination)
         ("head" markdown-ts-table-header)
         ("---" markdown-ts-table-delimiter-cell)
         ("one" markdown-ts-table-cell)
         ("```" markdown-ts-delimiter)
         ("elisp" markdown-ts-language-keyword)
         ("inline" markdown-ts-code-span))
       my/appearance-markdown-ts-attributes)
      (goto-char (point-min))
      (search-forward "(code)")
      (let ((code-block
             (seq-find (lambda (overlay)
                         (overlay-get overlay 'markdown-ts-code-block))
                       (overlays-at (match-beginning 0)))))
        (should code-block)
        (should (eq (overlay-get code-block 'face) 'markdown-ts-code-block))
        (my/appearance-assert-face-attributes
         'markdown-ts-code-block
         (cdr (assq 'markdown-ts-code-block my/appearance-markdown-ts-attributes)))))
    (dolist (mode '(markdown-mode gfm-mode))
      (with-temp-buffer
        (insert source)
        (funcall mode)
        (font-lock-ensure)
        (my/appearance-assert-tokens
         '(("#" markdown-header-delimiter-face)
           ("Heading" markdown-header-face-1)
           ("emphasis" markdown-italic-face)
           (">" markdown-markup-face)
           ("quote" markdown-blockquote-face)
           ("-" markdown-list-face)
           ("link" markdown-link-face)
           ("https://example.com" markdown-url-face)
           ("head" markdown-table-face)
           ("elisp" markdown-language-keyword-face)
           ("(code)" markdown-pre-face)
           ("inline" markdown-inline-code-face))
         '((markdown-header-delimiter-face :foreground "#8E817B")
           (markdown-header-face-1 :foreground "#2C363C" :weight bold)
           (markdown-italic-face :slant italic)
           (markdown-markup-face :foreground "#8E817B")
           (markdown-blockquote-face :foreground "#556570" :slant italic)
           (markdown-list-face :foreground "#4F5E68" :weight bold)
           (markdown-link-face :foreground "#44525B" :underline t)
           (markdown-url-face :foreground "#948985" :underline t)
           (markdown-table-face :foreground "#2C363C")
           (markdown-language-keyword-face :foreground "#2C363C" :weight bold)
           (markdown-pre-face :foreground "#6A5549" :background "#EBE7E6" :extend t)
           (markdown-inline-code-face :foreground "#6A5549" :background "#EBE7E6"
                                      :height 1.0 :extend nil))))))
  (dolist
      (pair
       '((markdown-header-face-1 markdown-ts-heading-1)
         (markdown-header-delimiter-face markdown-ts-delimiter)
         (markdown-blockquote-face markdown-ts-block-quote)
         (markdown-list-face markdown-ts-task-checked)
         (markdown-link-face markdown-ts-link)
         (markdown-url-face markdown-ts-link-destination)
         (markdown-table-face markdown-ts-table)
         (markdown-pre-face markdown-ts-code-block)
         (markdown-inline-code-face markdown-ts-code-span)))
    (dolist (attribute '(:foreground :background :height))
      (should (equal (face-attribute (nth 0 pair) attribute nil t)
                     (face-attribute (nth 1 pair) attribute nil t))))))

(ert-deftest my/appearance-org-todo-keywords-use-the-theme-palette ()
  (my/appearance-load-theme)
  (require 'org)
  (let ((expected
         '(("PROJ" :foreground "#286486" :weight bold)
           ("TODO" :foreground "#2C363C" :weight bold :underline t)
           ("REVIEW" :foreground "#88507D" :weight bold)
           ("POST" :foreground "#3B8992" :weight bold)
           ("DOING" :foreground "#944927" :weight bold)
           ("BLOCKED" :foreground "#A8334C" :weight bold)
           ("DONE" :foreground "#4F6C31" :weight bold)
           ("CANCELED" :foreground "#948985" :strike-through t))))
    (should (equal org-todo-keyword-faces expected))
    (with-temp-buffer
      (dolist (entry expected)
        (insert "* " (car entry) " task\n"))
      (org-mode)
      (font-lock-ensure)
      (goto-char (point-min))
      (dolist (entry expected)
        (should (search-forward (car entry) nil t))
        (let ((rendered (get-text-property (match-beginning 0) 'face)))
          (should (equal (car rendered) (cdr entry)))
          (should (memq 'org-level-1 (cdr rendered))))))))

(ert-deftest my/appearance-package-families-inherit-the-shared-palette ()
  (my/appearance-load-theme)
  (dolist
      (feature
       '(eglot markdown-mode markdown-ts-mode org org-agenda org-roam-mode
               org-roam-overlay org-roam-dailies org-ref org-ref-citation-links
               org-ref-glossary org-ref-label-link org-ref-ref-links magit
               magit-reflog magit-sequence magit-blame magit-bisect git-commit
               git-rebase dape consult consult-imenu embark which-key evil dired
               gptel gptel-context gptel-rewrite))
    (require feature))
  (dolist
      (spec
       '((markdown-inline-code-face (markdown-code-face markdown-pre-face)
                                    :foreground "#6A5549" :background "#EBE7E6"
                                    :height 1.0 :extend nil)
         (markdown-ts-code-span (markdown-ts-code-block font-lock-constant-face)
                                :foreground "#6A5549" :background "#EBE7E6"
                                :height 1.0 :extend nil)
         (org-headline-todo org-todo :foreground "#2C363C" :weight bold :underline t)
         (org-agenda-calendar-daterange org-date :foreground "#944927")
         (org-roam-header-line header-line :foreground "#2C363C" :background "#D6CDC9")
         (org-ref-bad-cite-key-face error :foreground "#A8334C")
         (magit-process-ok success :foreground "#4F6C31")
         (git-commit-overlong-summary error :foreground "#A8334C")
         (git-rebase-hash magit-hash :foreground "#948985")
         (dape-inlay-hint-face eglot-inlay-hint-face :foreground "#A38C80"
                               :background "#EBE7E6" :height 1.0)
         (consult-async-running warning :foreground "#944927")
         (embark-target highlight :background "#E9E4E2" :extend t)
         (which-key-key-face unspecified :foreground "#2C363C" :weight bold)
         (evil-ex-search isearch :foreground "#F0EDEC" :background "#C074B2")
         (dired-broken-symlink error :foreground "#A8334C")
         (gptel-context-highlight-face unspecified :foreground "#2C363C"
                                       :background "#EBE7E6")))
    (let ((face (nth 0 spec))
          (parent (nth 1 spec))
          (attributes (nthcdr 2 spec)))
      (should (equal (face-attribute face :inherit nil) parent))
      (my/appearance-assert-face-attributes face attributes)))
  (my/appearance-verify-tree-sitter-tokens)
  (dolist
      (spec
       '((nim-font-lock-export-face font-lock-builtin-face)
         (nim-font-lock-pragma-face font-lock-preprocessor-face)
         (nim-non-overloadable-face font-lock-builtin-face)
         (nim-font-lock-number-face font-lock-number-face)
         (zig-multiline-string-face font-lock-string-face)
         (php-string font-lock-string-face)
         (php-keyword font-lock-keyword-face)
         (php-builtin font-lock-builtin-face)
         (php-function-name font-lock-function-name-face)
         (php-function-call-standard font-lock-function-call-face)
         (php-variable-name font-lock-variable-name-face)
         (php-property-name font-lock-property-name-face)
         (php-type font-lock-type-face)
         (php-constant font-lock-constant-face)
         (php-php-tag font-lock-preprocessor-face)
         (php-doc-annotation-tag font-lock-doc-markup-face)
         (php-operator font-lock-operator-face)))
    (require (pcase (car spec)
               ((or 'nim-font-lock-export-face 'nim-font-lock-pragma-face
                    'nim-non-overloadable-face 'nim-font-lock-number-face) 'nim-mode)
               ('zig-multiline-string-face 'zig-mode)
               (_ 'php-mode)))
    (should (eq (face-attribute (nth 0 spec) :inherit nil) (nth 1 spec)))
    (should (equal (face-attribute (nth 0 spec) :foreground nil t)
                   (face-attribute (nth 1 spec) :foreground nil t))))
  (require 'odin-mode)
  (with-temp-buffer
    (insert "package fallback\nmain :: proc() {}\n")
    (odin-mode)
    (font-lock-ensure)
    (my/appearance-assert-rendered-faces my/appearance-font-lock-attributes)
    (my/appearance-assert-tokens
     '(("package" font-lock-keyword-face)
       ("main" font-lock-function-name-face)
       ("proc" font-lock-keyword-face))
     my/appearance-font-lock-attributes)))

(ert-deftest my/appearance-ghostel-uses-the-ansi-palette ()
  (require 'ghostel)
  (my/appearance-load-theme)
  (my/appearance-assert-face-attributes
   'ghostel-default '(:foreground "#2C363C" :background "#F0EDEC"))
  (should (equal (face-attribute 'ghostel-fake-cursor :box nil t)
                 '(:line-width (-1 . -1) :color "#2C363C")))
  (should (eq (face-attribute 'ghostel-fake-cursor-box :inherit nil) 'cursor))
  (my/appearance-assert-face-attributes
   'ghostel-fake-cursor-box '(:foreground "#F0EDEC" :background "#2C363C"))
  (let ((palette
         '((ghostel-color-black ansi-color-black "#F0EDEC")
           (ghostel-color-red ansi-color-red "#A8334C")
           (ghostel-color-green ansi-color-green "#4F6C31")
           (ghostel-color-yellow ansi-color-yellow "#944927")
           (ghostel-color-blue ansi-color-blue "#286486")
           (ghostel-color-magenta ansi-color-magenta "#88507D")
           (ghostel-color-cyan ansi-color-cyan "#3B8992")
           (ghostel-color-white ansi-color-white "#2C363C")
           (ghostel-color-bright-black ansi-color-bright-black "#CFC1BA")
           (ghostel-color-bright-red ansi-color-bright-red "#94253E")
           (ghostel-color-bright-green ansi-color-bright-green "#3F5A22")
           (ghostel-color-bright-yellow ansi-color-bright-yellow "#803D1C")
           (ghostel-color-bright-blue ansi-color-bright-blue "#1D5573")
           (ghostel-color-bright-magenta ansi-color-bright-magenta "#7B3B70")
           (ghostel-color-bright-cyan ansi-color-bright-cyan "#2B747C")
           (ghostel-color-bright-white ansi-color-bright-white "#4F5E68"))))
    (should (equal ghostel-color-palette
                   (vconcat (mapcar #'car palette))))
    (dolist (spec palette)
