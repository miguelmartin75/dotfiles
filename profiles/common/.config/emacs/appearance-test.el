(defun my/appearance-load-theme ()
  "Enable the configured appearance theme before inspecting effective faces."
  (load-theme 'mig-zenbones-light t))

(defun my/appearance-assert-face-attributes (face attributes)
  "Assert that FACE resolves ATTRIBUTES through its active inheritance chain."
  (let ((remaining attributes))
    (while remaining
      (let ((attribute (pop remaining))
            (expected (pop remaining)))
        (let ((actual (face-attribute face attribute nil t)))
          (if (and (numberp actual) (numberp expected))
              (should (= actual expected))
            (should (equal actual expected))))))))

(defun my/appearance-assert-rendered-faces (attributes)
  "Assert every fontified face in the current buffer has an exact known role."
  (let ((position (point-min)))
    (while (< position (point-max))
      (let ((next (next-single-property-change position 'face nil (point-max)))
            (rendered (get-text-property position 'face)))
        (dolist (face (if (listp rendered) rendered (list rendered)))
          (when face
            (let ((expected (assq face attributes)))
              (should expected)
              (my/appearance-assert-face-attributes face (cdr expected)))))
        (setq position next)))))

(defun my/appearance-assert-tokens (tokens attributes)
  "Assert TOKENS carry their semantic faces and exact effective ATTRIBUTES."
  (goto-char (point-min))
  (dolist (token tokens)
    (let ((text (nth 0 token))
          (expected-face (nth 1 token)))
      (should (search-forward text nil t))
      (let ((rendered (get-text-property (match-beginning 0) 'face))
            (expected (assq expected-face attributes)))
        (should (memq expected-face
                      (if (listp rendered) rendered (list rendered))))
        (should expected)
        (my/appearance-assert-face-attributes expected-face (cdr expected))))))

